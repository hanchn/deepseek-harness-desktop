{
  "name": "dsh-market",
  "version": "0.1.0",
  "private": true,
  "description": "Market pages for the DSH Web UI Settings: CLI catalog (detect only, copy install command), skill marketplace (pinned-commit sources), and custom skill authoring.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "cordis.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
